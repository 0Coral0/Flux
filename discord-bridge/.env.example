DISCORD_BOT_TOKEN=
# The server ID. All ordinary-member-visible channels are discovered automatically.
DISCORD_GUILD_ID=
# Optional legacy single-channel webhook; it does not restrict discovery.
DISCORD_CHANNEL_ID=
FIREBASE_PROJECT_ID=aggw-themes
# Use (default) only after verifying that client rules deny all bridgePrivate access.
BRIDGE_FIRESTORE_DATABASE=(default)
GOOGLE_APPLICATION_CREDENTIALS=C:/private/flux-service-account.json
FLUX_SITE_ORIGIN=https://your-flux-site.example
BRIDGE_PUBLIC_URL=https://your-bridge.example
DISCORD_WEBHOOK_URL=
# Optional JSON object: {"CHANNEL_ID":"https://discord.com/api/webhooks/..."}
DISCORD_WEBHOOK_URLS={}
PORT=3032
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
