DISCORD_BOT_TOKEN=
# The server ID. All ordinary-member-visible channels are discovered automatically.
DISCORD_GUILD_ID=
# Optional legacy single-channel webhook; it does not restrict discovery.
DISCORD_CHANNEL_ID=
FIREBASE_PROJECT_ID=aggw-themes
# Use (default) only after verifying that client rules deny all bridgePrivate access.
BRIDGE_FIRESTORE_DATABASE=(default)
GOOGLE_APPLICATION_CREDENTIALS=C:/private/flux-service-account.json
# For Render, paste the complete service-account JSON into this secret instead
# of supplying GOOGLE_APPLICATION_CREDENTIALS. Never set both in a public file.
FIREBASE_SERVICE_ACCOUNT_JSON=
FLUX_SITE_ORIGIN=https://your-flux-site.example
BRIDGE_PUBLIC_URL=https://your-bridge.example
DISCORD_WEBHOOK_URL=
# Optional JSON object: {"CHANNEL_ID":"https://discord.com/api/webhooks/..."}
DISCORD_WEBHOOK_URLS={}
PORT=3032
# Keep 127.0.0.1 for a normal PC or VM install. Docker uses 0.0.0.0 inside
# its private network while the host still exposes only loopback to Caddy.
BRIDGE_BIND_HOST=127.0.0.1
# Enable only when the bridge is reachable exclusively through the supplied
# Caddy configuration, which replaces X-Flux-Client-IP with the visitor IP.
TRUST_PROXY_CLIENT_IP=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional comma-separated Firebase UIDs for accounts the AI should recognize as Flux's creator.
FLUX_CREATOR_UIDS=
